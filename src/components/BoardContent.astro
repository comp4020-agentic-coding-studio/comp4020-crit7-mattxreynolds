---
import OwnOffer from "./OwnOffer.astro";
import PostEntry from "./PostEntry.astro";
import { offersMadeBy } from "../lib/offer-store";
import { listOpenPosts, swappedPostIdFor } from "../lib/posts";
import type { Student } from "../lib/schema";

interface Props {
  student: Student;
}

// The board's own content (0019): the one render path for `/` and for the
// refetch at /fragments/board/, so a live board and a reloaded board can't
// disagree (0042). The flash notice is not part of it: it is read once by the
// page, so a refetch never shows it again.
const { student } = Astro.props;
const open = listOpenPosts();
const mine = open.find((post) => post.studentId === student.id);
const others = open.filter((post) => post !== mine);
// after an accept the poster's spot links to the swapped post until they post
// again (0024)
const swappedPostId = mine ? null : swappedPostIdFor(student.id);
// "Your offers" (0019, 0025): every offer the student has made, pending first;
// the section appears only once they have made one
const madeOffers = offersMadeBy(student.id);
---

<div class="board-split">
  <div class="side-column">
    <section aria-labelledby="your-post">
      <h2 id="your-post">Your post</h2>
      {mine ? <PostEntry post={mine} own /> : <a class="button primary" href="/posts/new/">Post a swap</a>}
      {
        swappedPostId !== null && (
          <p class="swapped-line">
            Your last post was swapped. <a href={`/posts/${swappedPostId}/`}>See the swapped post</a>.
          </p>
        )
      }
    </section>
    {
      madeOffers.length > 0 && (
        <section aria-labelledby="your-offers">
          <h2 id="your-offers">Your offers</h2>
          <ul class="your-offers">
            {madeOffers.map((offer) => (
              <li>
                <OwnOffer offer={offer} next="/" link />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
  <div class="main-column">
    <section aria-labelledby="open-posts">
      <h2 id="open-posts">Open posts</h2>
      {others.length === 0 ? <p>No other open swap posts.</p> : others.map((post) => <PostEntry post={post} />)}
    </section>
  </div>
</div>

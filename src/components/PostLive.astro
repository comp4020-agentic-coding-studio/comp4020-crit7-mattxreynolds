---
import ExchangeRow from "./ExchangeRow.astro";
import MessageLink from "./MessageLink.astro";
import OwnOffer from "./OwnOffer.astro";
import PostControls from "./PostControls.astro";
import { classLabel } from "../lib/classes";
import { commentsOn } from "../lib/comments";
import { acceptedSwapOn, declinedOfferOn, ownOfferOn, pendingOffersOn } from "../lib/offer-store";
import { countLabel, swappedSentence } from "../lib/offers";
import { withdrawnBySwap, type PostView } from "../lib/posts";
import type { Student } from "../lib/schema";
import { formatCanberra } from "../lib/time";

interface Props {
  post: PostView;
  student: Student | null;
}

// The post page's live part (0044, 0057): the one render path for /posts/N/
// and for the refetch at /fragments/posts/N/. Three parts, in the order the
// page stacks them at 390px: the header (the exchange row, the status
// sentences, the message, status, times, pending-offer count and own-post
// controls), the offers column, then the comment thread (0026, 0029). The poster sees each
// pending offer and who made it, an offerer sees their own offer and its
// status, anyone else sees only the count (0023). The count and the poster's
// Offers are the attention colour while an offer is pending (0058). The thread
// is oldest first, a deleted comment a bare placeholder (0027), the author's
// Delete only while the post is open. Beside a username — the poster, each
// commenter, each offerer in the poster's view, both students of a swap — is a
// "Message" link (0030), never beside the viewer's own. The comment box is not
// here: it sits outside this region so a half-typed comment survives a refresh
// (0044). Controls that no longer apply aren't rendered, so they disappear on a
// refresh. The parts are siblings of one grid, the region being display:
// contents (src/styles.css), so the comment box can sit under the thread.
const { post, student } = Astro.props;
const isPoster = post.studentId === student?.id;
// whether a username is the viewer's own, so it gets no Message link (0030)
const isOther = (username: string): boolean => student !== null && student.username !== username;
const pageUrl = `/posts/${post.id}/`;
const thread = commentsOn(post.id);
const pendingOffers = isPoster ? pendingOffersOn(post.id) : [];
const swap = post.status === "swapped" ? acceptedSwapOn(post.id) : null;
const ownOffer = student && !isPoster ? ownOfferOn(student.id, post.id) : null;
const canOffer =
  post.status === "open" &&
  student !== null &&
  !isPoster &&
  ownOffer?.status !== "pending" &&
  !declinedOfferOn(student.id, post.id);
// the count and the poster's Offers are the attention colour while an offer
// waits on the poster (0058)
const attention = isPoster && post.status === "open" && post.pendingOffers >= 1;
// no offer panel: the comments take the whole width
const hasOfferPanel = isPoster || ownOffer !== null || canOffer;
const STATUS_LABEL: Record<string, string> = { open: "Open", withdrawn: "Withdrawn", swapped: "Swapped" };
---

<div class="post-header">
  <p class="status-line">
    <span class="exchange-label">Status</span>
    <span class="post-status">{STATUS_LABEL[post.status]}</span>
  </p>
  <ExchangeRow leaving={post.leaving} joins={post.joins} large />
  {
    post.status === "withdrawn" && post.withdrawnAt && (
      <p class="withdrawn">
        This swap post was withdrawn
        {withdrawnBySwap(post) && " automatically"} on{" "}
        <time datetime={post.withdrawnAt.toISOString()}>{formatCanberra(post.withdrawnAt)}</time>
        {withdrawnBySwap(post) && " because its poster swapped with someone else"}
      </p>
    )
  }
  {
    swap && (
      <p class="swapped">
        {swappedSentence({
          poster: post.username,
          offered: classLabel(swap.offered),
          offerer: swap.offerer,
          leaving: classLabel(post.leaving),
        })}
      </p>
    )
  }
  {
    swap && isOther(swap.offerer) && (
      <p class="swapped-offerer">
        {swap.offerer} <MessageLink username={swap.offerer} />
      </p>
    )
  }
  {
    isOther(post.username) && (
      <p class="poster-line">
        Posted by <strong>{post.username}</strong> <MessageLink username={post.username} />
      </p>
    )
  }
  <p class:list={["message", { "no-message": post.message === null }]}>{post.message ?? "No message"}</p>
  <dl class="post-facts">
    <dt>Posted</dt>
    <dd>
      <time datetime={post.postedAt.toISOString()}>{formatCanberra(post.postedAt)}</time>
    </dd>
    {
      post.editedAt && (
        <>
          <dt>Edited</dt>
          <dd class="edited">
            <time datetime={post.editedAt.toISOString()}>{formatCanberra(post.editedAt)}</time>
          </dd>
        </>
      )
    }
  </dl>
  {
    post.status === "open" && (
      <p class="offer-count" data-attention={attention ? "" : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m2 12 4-4 4 2 3-1 3 3 4-1 2 3-5 5-3-1-3 2-4-2-3-2Z"/><path d="m8 11 4 4m0-6 5 5"/></svg>
        {countLabel(post.pendingOffers)}
      </p>
    )
  }
  {isPoster && post.status === "open" && (
    <div class="post-header-actions">
      <PostControls postId={post.id} next={pageUrl} />
    </div>
  )}
</div>
{
  hasOfferPanel && (
    <div class="side-column">
      {isPoster && (
        <section aria-labelledby="offers">
          <h2 id="offers" data-attention={attention ? "" : undefined}>
            Offers
          </h2>
          {pendingOffers.length > 0 ? (
            <ul class="offers" data-attention={attention ? "" : undefined}>
              {pendingOffers.map((offer) => (
                <li>
                  <span class="offer-who">
                    <span class="offer-text">
                      <strong>{offer.offerer}</strong> would leave <span class="class">{classLabel(offer.offered)}</span>
                    </span>
                    {isOther(offer.offerer) && <MessageLink username={offer.offerer} />}
                  </span>
                  <div class="controls">
                    <a class="button primary" href={`/offers/${offer.id}/accept/`}>
                      Accept
                    </a>
                    <form method="post" action={`/offers/${offer.id}/decline`}>
                      <input type="hidden" name="next" value={pageUrl} />
                      <button class="button secondary">Decline</button>
                    </form>
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <p class="no-offers">{post.status === "open" ? "No offers yet." : "No pending offers."}</p>
          )}
        </section>
      )}
      {ownOffer && (
        <section aria-labelledby="your-offer">
          <h2 id="your-offer">Your offer</h2>
          <OwnOffer offer={ownOffer} next={pageUrl} />
        </section>
      )}
      {canOffer && (
        <form method="post" action={`/posts/${post.id}/offers`} class="offer-form">
          <input type="hidden" name="next" value={pageUrl} />
          <fieldset>
            <legend>The class you hold and would leave</legend>
            {post.joins.map((c) => (
              <label class="choice">
                <input type="radio" name="class" value={c.id} checked={post.joins.length === 1} required />
                {classLabel(c)}
              </label>
            ))}
          </fieldset>
          <button class="button primary">Offer to swap</button>
        </form>
      )}
    </div>
  )
}
<section aria-labelledby="comments" class="comments">
  <h2 id="comments">Comments</h2>
  {
    thread.length === 0 ? (
      <p class="no-comments">{post.status === "open" ? "No comments yet." : "No comments."}</p>
    ) : (
      <ul class="comment-list">
        {thread.map((comment) =>
          comment.deleted ? (
            <li class="comment deleted">Comment deleted</li>
          ) : (
            <li class="comment">
              <p class="comment-head">
                <strong>{comment.author}</strong>
                {comment.byPoster && <span class="poster-tag">poster</span>}{" "}
                {isOther(comment.author) && (
                  <>
                    <MessageLink username={comment.author} />{" "}
                  </>
                )}
                <time datetime={comment.createdAt.toISOString()}>{formatCanberra(comment.createdAt)}</time>
              </p>
              <p class="comment-body">{comment.body}</p>
              {post.status === "open" && comment.authorId === student?.id && (
                <form method="post" action={`/comments/${comment.id}/delete`}>
                  <input type="hidden" name="next" value={pageUrl} />
                  <button class="button secondary">Delete</button>
                </form>
              )}
            </li>
          ),
        )}
      </ul>
    )
  }
</section>

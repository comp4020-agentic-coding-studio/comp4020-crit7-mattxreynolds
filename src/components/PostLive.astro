---
import OwnOffer from "./OwnOffer.astro";
import PostControls from "./PostControls.astro";
import { classLabel } from "../lib/classes";
import { commentsOn } from "../lib/comments";
import { acceptedSwapOn, declinedOfferOn, ownOfferOn, pendingOffersOn } from "../lib/offer-store";
import { countLabel, swappedSentence } from "../lib/offers";
import { withdrawnBySwap, type PostView } from "../lib/posts";
import type { Student } from "../lib/schema";
import { formatCanberra } from "../lib/time";

interface Props {
  post: PostView;
  student: Student | null;
}

// The post page's live part (0044): the post, its status, its pending-offer
// count and what this viewer sees of its offers (0023) — the one render path
// for /posts/N/ and for the refetch at /fragments/posts/N/. The poster sees
// each pending offer and who made it, an offerer sees their own offer and its
// status, anyone else sees only the count. Below it all is the comment thread
// (0026, 0029): oldest first, a deleted comment a bare placeholder (0027), the
// author's Delete only while the post is open. The comment box is not here: it
// sits outside this region so a half-typed comment survives a refresh (0044).
// Controls that no longer apply aren't rendered, so they disappear on a
// refresh.
const { post, student } = Astro.props;
const isPoster = post.studentId === student?.id;
const pageUrl = `/posts/${post.id}/`;
const thread = commentsOn(post.id);
const pendingOffers = isPoster ? pendingOffersOn(post.id) : [];
const swap = post.status === "swapped" ? acceptedSwapOn(post.id) : null;
const ownOffer = student && !isPoster ? ownOfferOn(student.id, post.id) : null;
const canOffer =
  post.status === "open" &&
  student !== null &&
  !isPoster &&
  ownOffer?.status !== "pending" &&
  !declinedOfferOn(student.id, post.id);
---

{
  post.status === "withdrawn" && post.withdrawnAt && (
    <p class="withdrawn">
      This swap post was withdrawn
      {withdrawnBySwap(post) && " automatically"} on{" "}
      <time datetime={post.withdrawnAt.toISOString()}>{formatCanberra(post.withdrawnAt)}</time>
      {withdrawnBySwap(post) && " because its poster swapped with someone else"}
    </p>
  )
}
{
  swap && (
    <p class="swapped">
      {swappedSentence({
        poster: post.username,
        offered: classLabel(swap.offered),
        offerer: swap.offerer,
        leaving: classLabel(post.leaving),
      })}
    </p>
  )
}
<dl>
  <dt>Poster</dt>
  <dd>{post.username}</dd>
  <dt>Leaving</dt>
  <dd>{classLabel(post.leaving)}</dd>
  <dt>Would join</dt>
  <dd>{post.joins.map((c) => classLabel(c)).join(", ")}</dd>
  <dt>Message</dt>
  <dd class="message">{post.message ?? "No message"}</dd>
  <dt>Posted</dt>
  <dd>
    <time datetime={post.postedAt.toISOString()}>{formatCanberra(post.postedAt)}</time>
  </dd>
  {
    post.editedAt && (
      <>
        <dt>Edited</dt>
        <dd class="edited">
          <time datetime={post.editedAt.toISOString()}>{formatCanberra(post.editedAt)}</time>
        </dd>
      </>
    )
  }
</dl>
{post.status === "open" && <p class="offer-count">{countLabel(post.pendingOffers)}</p>}
{
  pendingOffers.length > 0 && (
    <section aria-labelledby="offers">
      <h2 id="offers">Offers</h2>
      <ul class="offers">
        {pendingOffers.map((offer) => (
          <li>
            <span class="offer-text">
              <strong>{offer.offerer}</strong> would leave <span class="class">{classLabel(offer.offered)}</span>
            </span>
            <div class="controls">
              <a class="button" href={`/offers/${offer.id}/accept/`}>
                Accept
              </a>
              <form method="post" action={`/offers/${offer.id}/decline`}>
                <input type="hidden" name="next" value={pageUrl} />
                <button>Decline</button>
              </form>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}
{
  ownOffer && (
    <section aria-labelledby="your-offer">
      <h2 id="your-offer">Your offer</h2>
      <OwnOffer offer={ownOffer} next={pageUrl} />
    </section>
  )
}
{
  canOffer && (
    <form method="post" action={`/posts/${post.id}/offers`} class="offer-form">
      <input type="hidden" name="next" value={pageUrl} />
      <fieldset>
        <legend>The class you hold and would leave</legend>
        {post.joins.map((c) => (
          <label class="choice">
            <input type="radio" name="class" value={c.id} checked={post.joins.length === 1} required />
            {classLabel(c)}
          </label>
        ))}
      </fieldset>
      <button>Offer to swap</button>
    </form>
  )
}
{isPoster && post.status === "open" && <PostControls postId={post.id} next={pageUrl} />}
<section aria-labelledby="comments" class="comments">
  <h2 id="comments">Comments</h2>
  {
    thread.length === 0 ? (
      <p class="no-comments">{post.status === "open" ? "No comments yet." : "No comments."}</p>
    ) : (
      <ul class="comment-list">
        {thread.map((comment) =>
          comment.deleted ? (
            <li class="comment deleted">Comment deleted</li>
          ) : (
            <li class="comment">
              <p class="comment-head">
                <strong>{comment.author}</strong>
                {comment.byPoster && <span class="poster-tag">poster</span>}{" "}
                <time datetime={comment.createdAt.toISOString()}>{formatCanberra(comment.createdAt)}</time>
              </p>
              <p class="comment-body">{comment.body}</p>
              {post.status === "open" && comment.authorId === student?.id && (
                <form method="post" action={`/comments/${comment.id}/delete`}>
                  <input type="hidden" name="next" value={pageUrl} />
                  <button>Delete</button>
                </form>
              )}
            </li>
          ),
        )}
      </ul>
    )
  }
</section>

---
import { classLabel } from "../lib/classes";
import type { SchoolClass } from "../lib/schema";

interface Props {
  leaving: SchoolClass;
  joins: SchoolClass[];
  // the post page's header sets it larger
  large?: boolean;
}

// The exchange row (0057): GIVING the leaving class, then LOOKING FOR every
// join class. It opens a board entry; the post page reuses it, enlarged.
const { leaving, joins, large = false } = Astro.props;
---

<div class:list={["swap-exchange", "post-exchange", { large }]}>
  <div class="swap-giving">
    <span class="exchange-label">Giving</span>
    <span class="class">{classLabel(leaving)}</span>
  </div>
  <span class="swap-arrow" aria-hidden="true">→</span>
  <div class="swap-looking">
    <span class="exchange-label">Looking for</span>
    <ul class:list={["swap-times", { "many-times": joins.length >= 4 }]}>
      {joins.map((join) => <li class="class">{classLabel(join)}</li>)}
    </ul>
  </div>
</div>

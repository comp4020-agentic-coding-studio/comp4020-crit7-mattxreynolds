---
import { RANDOM_DEMO } from "../lib/auth";
import { demoOfferCounts } from "../lib/offer-store";
import { offersToAnswerLabel, countLabel } from "../lib/offers";
import { demoUnreadCounts, unreadLabel } from "../lib/privateMessages";
import { usernamesWithOpenPost } from "../lib/posts";
import { DEMO_USERNAMES } from "../lib/seed";

interface Props {
  next: string;
  error: string | null;
}

const { next, error } = Astro.props;
const demoChoices = [...DEMO_USERNAMES, RANDOM_DEMO];
// each demo student's live line (0039): counts and yes/no only, never what a
// post, an offer or a private message says. Its parts: offers waiting on their
// open post, or just that they have one; offers they have made; unread private
// messages; and "no post yet" when there is nothing else to say.
const withPost = usernamesWithOpenPost(DEMO_USERNAMES);
const offerCounts = demoOfferCounts(DEMO_USERNAMES);
const unreadCounts = demoUnreadCounts(DEMO_USERNAMES);
function demoLine(name: string): string {
  const { toAnswer = 0, made = 0 } = offerCounts.get(name) ?? {};
  const parts: string[] = [];
  if (withPost.has(name)) parts.push(toAnswer > 0 ? offersToAnswerLabel(toAnswer) : "open post");
  if (made > 0) parts.push(countLabel(made));
  const unread = unreadCounts.get(name) ?? 0;
  if (unread > 0) parts.push(unreadLabel(unread));
  return parts.length > 0 ? parts.join(" · ") : "no post yet";
}
---

<div class="auth-page">
  <h1>Log in</h1>
  <p class="tagline">Post the class you're leaving, see who'd swap, and agree it together.</p>
  <section class="auth-card">
    <h2>Username and password</h2>
    {error && <p role="alert" data-attention>{error}</p>}
    <form method="post" action="/api/login">
      <input type="hidden" name="next" value={next} />
      <label for="username">Username</label>
      <input id="username" name="username" required autocomplete="username" />
      <label for="password">Password</label>
      <input id="password" name="password" type="password" required autocomplete="current-password" />
      <button class="button primary">Log in</button>
    </form>
    <p><a href={`/signup/?next=${encodeURIComponent(next)}`}>Sign up instead</a></p>
  </section>

  <section class="auth-card">
    <h2>Demo students</h2>
    <p>One click, no typing. Demo students are shared: anyone can be one.</p>
    <ul class="demo-students">
      {
        demoChoices.map((choice) => (
          <li>
            <form method="post" action="/login/demo">
              <input type="hidden" name="next" value={next} />
              <input type="hidden" name="username" value={choice} />
              <button class="button secondary">{choice === RANDOM_DEMO ? "Random demo student" : choice}</button>
            </form>
            {choice !== RANDOM_DEMO && (
              <span class="demo-line">
                {choice}: {demoLine(choice)}
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</div>

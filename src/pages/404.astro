---
import Layout from "../layouts/Layout.astro";
import NotFound from "../components/NotFound.astro";

// Any address that isn't a page: the board's own shell instead of the framework's.
Astro.response.status = 404;
---

<Layout title="Page not found" student={Astro.locals.student}>
  <NotFound heading="Page not found">There is no page at that address.</NotFound>
</Layout>

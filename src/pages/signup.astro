---
import Layout from "../layouts/Layout.astro";
import { safeNextPath } from "../lib/auth";
import { DEMO_LOGIN_NOTICE } from "../lib/notice";

const next = safeNextPath(Astro.url.searchParams.get("next"));

if (Astro.locals.student) {
  return Astro.redirect(next);
}

const error = Astro.url.searchParams.get("error");
const username = Astro.url.searchParams.get("username") ?? "";
---

<Layout title="Sign up" student={null}>
  <div class="auth-page auth-redesign signup-page">
    <div class="auth-heading">
      <span class="course-label">COMP4020</span>
      <h1>Sign up</h1>
    </div>
    <section class="auth-card">
      <h2>Choose a username and password</h2>
      <p class="signup-notice">{DEMO_LOGIN_NOTICE}</p>
      {error && <p role="alert" data-attention>{error}</p>}
      <form method="post" action="/api/signup">
        <input type="hidden" name="next" value={next} />
        <label for="username">Username</label>
        <input
          id="username"
          name="username"
          required
          minlength="3"
          maxlength="20"
          pattern="[A-Za-z0-9_-]+"
          value={username}
          autocomplete="username"
        />
        <label for="password">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          required
          minlength="8"
          autocomplete="new-password"
        />
        <div class="auth-actions">
          <button class="button primary">Sign up</button>
          <a class="auth-switch" href={`/login/?next=${encodeURIComponent(next)}`}>Log in instead</a>
        </div>
      </form>
    </section>
  </div>
</Layout>

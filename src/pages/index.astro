---
import LoginForm from "../components/LoginForm.astro";
import BoardContent from "../components/BoardContent.astro";
import Layout from "../layouts/Layout.astro";
import { takeFlash } from "../lib/flash";

// A logged-out visitor gets the login page here, in place, with a 200 (0048)
// — the deploy probe and the link check both fetch "/" without following
// redirects. src/middleware.ts lets a logged-out "/" through for exactly
// this reason; every other protected page redirects instead.
const student = Astro.locals.student;

// The board (0019) is BoardContent; the notice is read here, once, and stays
// out of the content the live refresh swaps (0042).
const notice = student ? takeFlash(Astro.cookies) : null;
---

<Layout title={student ? "Agentic Coding Studio | Swap Board" : "Log in"} student={student}>
  {
    student ? (
      <>
        <div class="board-heading">
          <div class="board-heading-main">
            <span class="course-label">COMP4020</span>
            <h1>Agentic Coding Studio</h1>
          </div>
          <div class="board-heading-detail" aria-label="Same classes, different paths. Students swap progress together.">
            <span>Same<br />classes<br />different<br />paths</span>
            <span>Students<br />swap<br />progress<br />together</span>
          </div>
        </div>
        {notice && <p role="status">{notice}</p>}
        <div id="board-live" data-live-url="/fragments/board/">
          <BoardContent student={student} />
        </div>
        <div id="live-announce" class="visually-hidden" aria-live="polite"></div>
      </>
    ) : (
      <LoginForm next="/" error={null} />
    )
  }
</Layout>

<script>
  import { boardRefetchOn, parseLiveEvent } from "../lib/live";
  import { startLive } from "../scripts/live";

  const container = document.getElementById("board-live");
  if (container) {
    startLive({
      container,
      url: container.dataset.liveUrl ?? "",
      wants: (data) => boardRefetchOn(parseLiveEvent(data)),
      announce: { region: document.getElementById("live-announce"), text: "Board updated" },
    });
  }
</script>

---
import Layout from "../../layouts/Layout.astro";
import PostForm from "../../components/PostForm.astro";
import { setFlash } from "../../lib/flash";
import { allClasses, createPost, openPostIdFor } from "../../lib/posts";

// Posting a swap (0016, 0017). This page takes its own POST: a refused post
// is this page again with the reason and what was typed, and a created one
// lands on the board with a notice (0019, 0045).
const student = Astro.locals.student;
if (!student) return Astro.redirect("/login/?next=%2Fposts%2Fnew%2F");

const classes = allClasses();
let error: string | null = null;
let existingPostId = openPostIdFor(student.id);
let leaving = "";
let joins: string[] = [];
let message = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  leaving = String(form.get("leaving") ?? "");
  joins = form.getAll("join").map(String);
  message = String(form.get("message") ?? "");

  const result = createPost(student.id, { leavingClassId: leaving, joinClassIds: joins, message });
  if (result.ok) {
    setFlash(Astro.cookies, Astro.request, "post-created");
    return Astro.redirect("/", 303);
  }
  error = result.error;
  existingPostId = result.existingPostId ?? existingPostId;
  Astro.response.status = result.existingPostId !== undefined ? 409 : 400;
}
---

<Layout title="Post a swap" student={student}>
  <div class="form-page">
  <h1>Post a swap</h1>
  {error && <p role="alert" data-attention>{error}</p>}
  {
    existingPostId !== null ? (
      <p>
        You already have an open post: <a href={`/posts/${existingPostId}/`}>view your post</a>.
      </p>
    ) : (
      <PostForm action="/posts/new/" classes={classes} leaving={leaving} joins={joins} message={message} submitLabel="Post swap" />
    )
  }
  <p class="back-link"><a href="/">Back to the board</a></p>
  </div>
</Layout>


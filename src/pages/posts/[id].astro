---
import PostLive from "../../components/PostLive.astro";
import Layout from "../../layouts/Layout.astro";
import { COMMENT_MAX } from "../../lib/comments";
import NotFound from "../../components/NotFound.astro";
import { getPost } from "../../lib/posts";

// The post page (0020): the whole post, edited marker included (0018). A
// withdrawn post still loads, says so with the time (and that a swap withdrew
// it, 0024) and has no controls; a swapped one says who moved where. An id
// that never existed is a 404. The rest is PostLive, which /fragments/posts/N/
// renders too (0044). The comment box (0026) stays out of PostLive, so the live
// refresh never swaps it and a half-typed comment survives; it is drawn only
// for an open post. .post-split is the grid around both (0057): the region
// (display: contents) puts its header, side column and thread in it, and the
// box goes under the thread.
const student = Astro.locals.student;
const id = /^[0-9]+$/.test(Astro.params.id ?? "") ? Number(Astro.params.id) : null;
const post = id === null ? null : getPost(id);
if (!post) Astro.response.status = 404;
---

<Layout title={post ? `Swap post by ${post.username}` : "Swap post not found"} student={student}>
  {
    post ? (
      <div class="post-page">
        <a class="post-back" href="/"><span aria-hidden="true">←</span> Back to the board</a>
        <div class="post-heading">
          <span class="course-label">COMP4020</span>
          <h1>Swap post by {post.username}</h1>
        </div>
        <div class="post-split">
          <div id="post-live" data-live-url={`/fragments/posts/${post.id}/`} data-post-id={post.id}>
            <PostLive post={post} student={student} />
          </div>
          {student && post.status === "open" && (
            <form method="post" action={`/posts/${post.id}/comments`} class="comment-form">
              <input type="hidden" name="next" value={`/posts/${post.id}/`} />
              <label for="comment-body">Add a comment (up to {COMMENT_MAX} characters)</label>
              <textarea id="comment-body" name="body" rows="3" maxlength={COMMENT_MAX} required />
              <button class="button primary">Comment</button>
            </form>
          )}
        </div>
      </div>
    ) : (
      <NotFound heading="Swap post not found">There is no swap post with that number.</NotFound>
    )
  }
</Layout>

<script>
  import { parseLiveEvent, postRefetchOn } from "../../lib/live";
  import { startLive } from "../../scripts/live";

  const container = document.getElementById("post-live");
  if (container) {
    const postId = Number(container.dataset.postId);
    startLive({
      container,
      url: container.dataset.liveUrl ?? "",
      wants: (data) => postRefetchOn(parseLiveEvent(data), postId),
    });
  }
</script>

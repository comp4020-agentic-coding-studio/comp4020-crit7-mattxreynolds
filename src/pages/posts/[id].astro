---
import PostLive from "../../components/PostLive.astro";
import Layout from "../../layouts/Layout.astro";
import { getPost } from "../../lib/posts";

// The post page (0020): the whole post, edited marker included (0018). A
// withdrawn post still loads, says so with the time (and that a swap withdrew
// it, 0024) and has no controls; a swapped one says who moved where. An id
// that never existed is a 404. The rest is PostLive, which /fragments/posts/N/
// renders too (0044).
const student = Astro.locals.student;
const id = /^[0-9]+$/.test(Astro.params.id ?? "") ? Number(Astro.params.id) : null;
const post = id === null ? null : getPost(id);
if (!post) Astro.response.status = 404;
---

<Layout title={post ? `Swap post by ${post.username}` : "Swap post not found"} student={student}>
  {
    post ? (
      <>
        <h1>Swap post by {post.username}</h1>
        <div id="post-live" data-live-url={`/fragments/posts/${post.id}/`} data-post-id={post.id}>
          <PostLive post={post} student={student} />
        </div>
        <p>
          <a href="/">Back to the board</a>
        </p>
      </>
    ) : (
      <>
        <h1>Swap post not found</h1>
        <p>
          There is no swap post with that number. <a href="/">Back to the board</a>
        </p>
      </>
    )
  }
</Layout>

<script>
  import { parseLiveEvent, postRefetchOn } from "../../lib/live";
  import { startLive } from "../../scripts/live";

  const container = document.getElementById("post-live");
  if (container) {
    const postId = Number(container.dataset.postId);
    startLive({
      container,
      url: container.dataset.liveUrl ?? "",
      wants: (data) => postRefetchOn(parseLiveEvent(data), postId),
    });
  }
</script>

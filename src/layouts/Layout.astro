---
import "../styles.css";
import { unreadCount } from "../lib/privateMessages";
import { UNOFFICIAL_FOOTER } from "../lib/notice";
import type { Student } from "../lib/schema";

interface Props {
  title: string;
  student: Student | null;
}

const { title, student } = Astro.props;
// the header count (0033): read when the page renders, so it moves on reload only
const unread = student ? unreadCount(student.id) : 0;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <span class="wordmark">Swap Board</span>
      <nav aria-label="site">
        {student && <a href="/">Board</a>}
        {
          student && (
            <a href="/messages/" data-attention={unread > 0 ? "" : undefined}>
              {unread > 0 ? `Messages (${unread})` : "Messages"}
            </a>
          )
        }
        <a href="/readme/">About</a>
        {
          student && (
            <form method="post" action="/logout">
              <button class="button secondary">Log out</button>
            </form>
          )
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>{UNOFFICIAL_FOOTER}</p>
    </footer>
  </body>
</html>

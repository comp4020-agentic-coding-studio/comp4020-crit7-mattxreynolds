#!/bin/sh
# Rejects a commit message that would close an issue when it reaches GitHub.
# Only Matt accepts work, so issues close by hand, never from a commit: write
# "Refs #N" instead of "Fixes #N" / "Closes #N" / "Resolves #N".
#
# GitHub's closing keywords: close(s|d), fix(es|ed), resolve(s|d), followed by
# an optional colon and #N, owner/repo#N, or an issue URL.

msg_file="$1"

# Ignore git's comment lines and anything below a --verbose scissors line.
body=$(sed -e '/^# -\{24\} >8 -\{24\}$/,$d' -e '/^#/d' "$msg_file")

keyword='(close[sd]?|fix(e[sd])?|resolve[sd]?)'
target='([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?#[0-9]+|https?://github\.com/[^[:space:]]+/issues/[0-9]+'

hits=$(printf '%s\n' "$body" | grep -inE "(^|[^A-Za-z0-9_])$keyword[[:space:]]*:?[[:space:]]+($target)")

if [ -n "$hits" ]; then
	echo "commit blocked: the message would close an issue on GitHub" >&2
	printf '%s\n' "$hits" | sed 's/^/  line /' >&2
	echo "" >&2
	echo "Only Matt closes issues. Reference the issue with 'Refs #N' instead." >&2
	exit 1
fi

if ! printf '%s\n' "$body" | grep -qE '(^|[[:space:]])Refs #[0-9]+'; then
	echo "note: no 'Refs #N' in this message; commits should cite their issue" >&2
fi

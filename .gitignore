node_modules/
dist/
.astro/
*.log

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# the local dev database — state on your machine, never in the repo
.data/

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local by default: settings in
# here can hold your course API key, and this repo goes public when you ship.
# Only the reviewed, keyless harness files are tracked; everything else in it,
# settings.local.json included, stays ignored.
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/agents/
!.claude/hooks/

# disposable session memory (handoffs, review bundles, scratch screenshots);
# the durable record is GitHub Issues
.scratch/

# Playwright output: screenshots are attached to issues, never committed
test-results/
playwright-report/
blob-report/

{
  "name": "comp4020-dynamic-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "astro dev",
    "build": "astro build && pnpm build:seed-reset",
    "build:seed-reset": "esbuild src/seed-reset.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/seed-reset.mjs --log-level=warning",
    "preview": "astro preview",
    "typecheck": "astro check",
    "check": "pnpm typecheck && pnpm test",
    "check:evidence": "node scripts/check-evidence.ts",
    "cite": "node scripts/cite.ts",
    "probe": "scripts/probe.sh",
    "seed:reset": "pnpm build:seed-reset && node dist/seed-reset.mjs",
    "test": "pnpm build && vitest run",
    "e2e": "pnpm build && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "scripts/db-check.sh"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/node": "^11.1.6",
    "astro": "^7.3.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.3",
    "axe-core": "^4.13.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.9.0"
}
